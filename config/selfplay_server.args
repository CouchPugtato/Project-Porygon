run_0015_random_pool

--games
10

--concurrent-games
2

--model-a
random

--model-b
random

--showdown-dir
external/pokemon-showdown

--client-dir
external/pokemon-showdown-client

--server-host
127.0.0.1

--server-port
8000

--client-host
127.0.0.1

--client-port
8001

--client-entrypoint
play.pokemonshowdown.com/testclient-old.html

--serve-client
1

--format
gen9randomdoublesbattle

--reconnect-seconds
5
